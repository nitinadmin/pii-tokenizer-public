# AWS
AWS_REGION=us-east-1
# Prefer IAM roles, AWS SSO, or workload identity in production.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# S3
S3_BUCKET_NAME=pii-tokenizer-data
S3_VAULT_BUCKET_NAME=pii-tokenizer-tokenvault
AUTO_CREATE_BUCKETS=false

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Security
# Fail-closed malware gate. true is for local development without GuardDuty only.
GUARDDUTY_FAIL_OPEN=false
GUARDDUTY_MAX_WAIT=60
# Server-side only; clients cannot override it. When true, the pipeline halts
# before the LLM if validation fails or any detection engine is unavailable.
STRICT_VALIDATION=true
MAX_UPLOAD_SIZE_MB=10
UPLOAD_TTL_SECONDS=3600

# API
CORS_ORIGINS=http://localhost:3000
# The container image overrides this with /app/logs.
LOG_DIR=./logs
